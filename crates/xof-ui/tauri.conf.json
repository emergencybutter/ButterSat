{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ButterSat",
  "version": "0.1.0",
  "identifier": "org.buttersat.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ButterSat",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://services.arcgisonline.com; connect-src 'self' ipc: http://ipc.localhost https://services.arcgisonline.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Simulation",
    "shortDescription": "Streamed ortho scenery for X-Plane 12",
    "copyright": "ButterSat contributors, MIT licence. Includes WinFsp (C) Bill Zissimopoulos.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installerHooks": "installer/hooks.nsh", "installMode": "perMachine" }
    }
  }
}
