{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ButterSat",
  "version": "0.1.3",
  "identifier": "org.buttersat.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ButterSat",
        "width": 640,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://services.arcgisonline.com; connect-src 'self' ipc: http://ipc.localhost https://services.arcgisonline.com https://satsrv.butr.cc; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Simulation Game",
    "shortDescription": "Streamed ortho scenery for X-Plane 12",
    "copyright": "ButterSat contributors, MIT licence. Includes WinFsp (C) Bill Zissimopoulos.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installerHooks": "installer/hooks.nsh", "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCODhDNzVDRDRFMjcxNEMKUldSTWNlTFVYTWVJaTJMTGNJck8zY2lOdzBYWFFSU2w5ZlArUUl4azg1dEhIQm5yT2ZrNkp1ekkK",
      "endpoints": ["https://satsrv.butr.cc/updates/latest.json"]
    }
  }
}
